<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_order_form_inherit_tags_final" model="ir.ui.view">
        <field name="name">sale.order.form.tags.inherit</field>
        <field name="model">sale.order</field>

        <!-- Inherit Sale Order Form -->
        <field name="inherit_id" ref="sale.view_order_form"/>

        <field name="arch" type="xml">

            <!-- Insert after Payment Terms -->
            <xpath expr="//field[@name='payment_term_id']" position="after">

                <field name="partner_tags"
                       widget="many2many_tags"
                       readonly="1"/>

            </xpath>

            <xpath expr="//field[@name='partner_tags']" position="after">

                <field name="reference"/>

            </xpath>

        </field>
    </record>

</odoo>