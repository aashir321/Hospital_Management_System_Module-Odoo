<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<!-- Search View -->
    <record id="view_hospital_appointment_search" model="ir.ui.view">
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
                <search string="Appointment Details">
                    <field name="patient_id"/>
                    <field name="doctor_id"/>
                    <field name="department"/>
                    <field name="state"/>
                    <filter name="filter_draft" string="Draft" domain="[('state','=','draft')]"/>
                    <filter name="filter_done" string="Done" domain="[('state','=','done')]"/>
                    <filter name="filter_cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_by_doctor" string="Doctor" context="{'group_by': 'doctor_id'}"/>
                        <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                    </group>
                </search>
        </field>
    </record>
<!-- Tree or List View -->
    <record id="view_hospital_appointment_tree" model="ir.ui.view">
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
                <tree string="Appointment Details"> <!-- create="0" edit="0" delete="0" -->
                    <field name="patient_id" widget="many2one_avatar"/>     
                    <field name="appointment_date"/>
                    <field name="appointment_time"/>
                    <field name="doctor_id"/>
                    <field name="department"/>
                    <field name="Booking_date"/>
                    <field name="gender"/>
                    <field name="email"/>
                    <field name="priority"/>
                    <field name="state"/>
                </tree>
        </field>
    </record>

<!-- Form View -->
    <record id="view_hospital_appointment_form" model="ir.ui.view">
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
                <form string="Appointment Details">
                    <header>
                        <button name="action_create_invoice"
                                string="Create Invoice"
                                type="object"
                                class="oe_highlight"
                                states="draft,in_consultation"/>
                        <field name="state" widget="statusbar" nolabel="1" options="{'clickable':'1'}" statusbar_visible="draft,in_consultation,done"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_patient_invoices"
                                type="object" class="oe_stat_button" icon="fa-file-text-o">
                                <field name="invoice_count"
                                    widget="statinfo"
                                    string="Invoices"/>
                            </button>
                        </div>
                    <div class="oe_title">
                        <h1>
                            <field name="priority" widget="priority" class="mr-3"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="appointment_date"/>
                            <field name="doctor_id"/>
                            <field name="department" readonly="1"/>
                            <field name="Booking_date"/>
                            <field name="email"/>
                        </group>
                        <group>
                            <field name="appointment_time"/>
                            <field name="gender"/>
                            <field name="priority"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Appointment Details" name ="appointments_details">
                            <group> 
                                <field name="appointment_date"/>
                                <field name="appointment_time"/>
                                <field name="Booking_date"/>
                            </group>
                        </page>
                        <page string="Patient Details" name ="patient_details">
                            <group> 
                                <field name="patient_id"/>
                                <field name="gender"/>
                                <field name="email"/>
                            </group>
                        </page>
                        <page string="Clinical Notes" name="clinical_notes">
                            <group>
                                <field name="symptoms"/>
                                <field name="diagnosis"/>
                                <field name="doctor_notes"/>
                            </group>
                        </page>
                        <page string="Prescription" name ="prescription">
                            <group> 
                                <field name="prescription" widget="html"/>
                            </group>
                        </page>
                        <page string="Services">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="subtotal" readonly="1"/>
                                </tree>
                            </field>
                            <group>
                                <field name="grand_total" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                    </sheet>
                    <!-- Chatter -->
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
        </field>
    </record>


    <record id="action_Hospital_Appointment" model="ir.actions.act_window">
        <field name="name">Appointment Details</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hospital.appointment</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p>Create Your First Appointment</p>
        </field>
    </record>
    
    <menuitem id="Appointment_menu" 
        name="Appointment"
        action="action_Hospital_Appointment" 
        parent="main_appointment_menu_root" 
        sequence="0"/>

</odoo>