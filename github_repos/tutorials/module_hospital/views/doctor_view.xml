<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Doctor management views support the report's doctor section and keep the model usable. -->
    <record id="view_hospital_doctor_search" model="ir.ui.view">
        <field name="model">hospital.doctors</field>
        <field name="arch" type="xml">
            <search string="Doctor Details">
                <field name="name"/>
                <field name="department"/>
                <field name="email"/>
                <field name="phone"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_department" string="Department" context="{'group_by': 'department'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_hospital_doctor_tree" model="ir.ui.view">
        <field name="model">hospital.doctors</field>
        <field name="arch" type="xml">
            <tree string="Doctor Details">
                <field name="name"/>
                <field name="department"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="license_number"/>
            </tree>
        </field>
    </record>

    <record id="view_hospital_doctor_form" model="ir.ui.view">
        <field name="model">hospital.doctors</field>
        <field name="arch" type="xml">
            <form string="Doctor Details">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Doctor name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Professional Information">
                            <field name="department"/>
                            <field name="license_number"/>
                        </group>
                        <group string="Contact Information">
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Optional notes about specialization, availability, or remarks."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_Hospital_Doctor" model="ir.actions.act_window">
        <field name="name">Doctor Details</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hospital.doctors</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p>Create Your First Doctor</p>
        </field>
    </record>

    <menuitem id="Doctor_menu"
        name="Doctor"
        action="action_Hospital_Doctor"
        parent="hospital_menu_root"
        sequence="10"/>
</odoo>