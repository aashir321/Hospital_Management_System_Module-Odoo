<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<!-- Search View -->
    <record id="view_hospital_patient_search" model="ir.ui.view">
        <field name="model">hospital.patients</field>
        <field name="arch" type="xml">
                <search string="Patient Details">
                            <field name="name" string="Patient Name" filter_domain="['|',('name','ilike', self),('email','ilike', self)]"/>
                            <field name="age"/>
                            <field name="gender"/>
                            <field name="email" filter_domain="['|',('email','ilike', self),('name','ilike', self)]"/>
                            <field name="phone"/>
                            <field name="address"/>
                            <field name="medical_history"/>
                        <!-- Filters-->
                            <filter name="filter_male" string="Male" domain="[('gender','=','male')]"/>
                            <separator/>
                            <filter name="filter_female" string="Female" domain="[('gender','=','female')]"/>
                            <!-- <separator/>
                            <filter name="filter_kids" string="Kids" domain="[('age','&lt;=',5)]"/>
                            <separator/> -->
                            <filter name="filter_archive" string="Archived" domain="[('active','=',False)]"/>
                        <!-- Group By -->
                            <group expand="0" string="Group By">
                                <filter name="group_by_gender" string="Gender" context="{'group_by': 'gender'}"/>
                            </group>
                        <!-- searchpanel -->
                            <searchpanel>
                                <field name="gender" string="Gender" enable_counters="1" select="multi" icon="fa-venus-mars"/>
                            </searchpanel>
                </search>
        </field>
    </record>
<!-- Tree or List View -->
    <record id="view_hospital_patient_tree" model="ir.ui.view">
        <field name="model">hospital.patients</field>
        <field name="arch" type="xml">
                <tree string="Patient Details">
                            <field name="name" string="Patient Name"/>
                            <field name="age"/>
                            <field name="gender"/>
                            <field name="date_of_birth"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="address"/>
                            <field name="medical_history"/>
                </tree>
        </field>
    </record>

<!-- Form View -->
    <record id="view_hospital_patient_form" model="ir.ui.view">
        <field name="model">hospital.patients</field>
        <field name="arch" type="xml">
                <form string="Patient Details">
                    <header>
                        <!-- Direct report action for the patient medical PDF. -->
                        <button name="%(module_hospital.action_patient_medical_report)d" type="action" string="Print Patient Report"
                            class="oe_highlight" icon="fa-print"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Patient name"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Patient Information">
                                <field name="age" readonly="1"/>
                                <field name="gender"/>
                                <field name="blood_group"/>
                                <field name="date_of_birth"/>
                                <field name="phone"/>
                                <field name="email"/>
                                <field name="partner_id"/>
                                <field name="address"/>
                            </group>
                            <group string="Emergency and Billing">
                                <field name="emergency_contact_name"/>
                                <field name="emergency_contact_relationship"/>
                                <field name="emergency_contact_phone"/>
                                <field name="consultation_fee"/>
                                <field name="medicine_charges"/>
                                <field name="tax_amount"/>
                                <field name="discount_amount"/>
                                <field name="grand_total" readonly="1"/>
                                <field name="active" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Medical History">
                                <field name="medical_history" placeholder="Enter relevant medical history, allergies, and important notes."/>
                            </page>
                            <page string="Appointments">
                                <field name="appointment_ids" context="{'default_patient_id': id}" mode="tree,form" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="appointment_date"/>
                                        <field name="appointment_time"/>
                                        <field name="doctor_id"/>
                                        <field name="department"/>
                                        <field name="priority"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                                <button name="object_View_appointment" type="object" string="Refresh Appointment Highlight"
                                    class="btn btn-secondary mt-3" confirm="This will refresh the visual feedback only."/>
                            </page>
                        </notebook>
                        <div class="mt-3 d-flex gap-2 flex-wrap">
                            <button name="%(module_hospital.action_Hospital_Appointment)d" type="action" string="Create Appointment"
                            class="btn btn-primary" confirm="Are you sure you want to create an appointment for this patient?"/>
                        </div>
                    </sheet>
                    <!-- Chatter -->
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
        </field>
    </record>


    <record id="action_Hospital_Patient" model="ir.actions.act_window">
        <field name="name">Patient Details</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hospital.patients</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_male' : 1, 'search_default_group_by_gender': 1}</field>
        <field name="help" type="html">
            <p>Create Your First Patient</p>
        </field>
    </record>
    
    <menuitem id="Patient_menu" 
        name="Patient"
        action="action_Hospital_Patient" 
        parent="Patient_menu_root" 
        sequence="0"/>

</odoo>