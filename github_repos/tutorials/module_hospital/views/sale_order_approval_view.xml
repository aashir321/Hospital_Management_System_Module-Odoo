<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="sale_order_form_approval" model="ir.ui.view">
        <field name="name">sale.order.form.approval</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">

                <field name="approval_state" invisible="1"/>

                <button name="action_send_for_approval"
                        string="Send For Approval"
                        type="object"
                        class="btn-primary"
                        groups="base.group_user,!module_hospital.group_sale_order_approver"
                        attrs="{'invisible':[('approval_state','!=','draft')]}"/>

                <!-- Approve -->
                <button name="action_approve_order"
                        string="Approve"
                        type="object"
                        class="btn-success"
                        groups="module_hospital.group_sale_order_approver"
                        attrs="{'invisible':[('approval_state','!=','waiting')]}"/>

            </xpath>


            <!-- ================= CONFIRM BUTTON (SENT) ================= -->

            <xpath expr="//button[@id='action_confirm']" position="replace">

                <button name="action_confirm"
                        id="action_confirm"
                        string="Confirm"
                        type="object"
                        class="btn-primary"
                        attrs="{
                            'invisible':[
                                '|',
                                ('state','!=','sent'),
                                ('approval_state','!=','approved')
                            ]
                        }"/>

            </xpath>


            <!-- ================= CONFIRM BUTTON (DRAFT) ================= -->

            <xpath expr="(//button[@name='action_confirm'])[2]" position="replace">
                <button name="action_confirm"
                        string="Confirm"
                        type="object"
                        attrs="{
                            'invisible':[
                                '|',
                                ('state','!=','draft'),
                                ('approval_state','!=','approved')
                            ]
                        }"/>

                            </xpath>


            <!-- ================= APPROVAL INFO ================= -->

            <xpath expr="//sheet/group/group[2]" position="inside">

                <field name="approved_by" readonly="1"/>

                <field name="approval_date" readonly="1"/>

            </xpath>

        </field>

    </record>

</odoo>