<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_Hospital_Female_Patient" model="ir.actions.act_window">
        <field name="name">Patient Details</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hospital.patients</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="domain">[('gender','=','female')]</field>
        <field name="help" type="html">
            <p>Create Your First Female Patient</p>
        </field>
    </record>
    
    <menuitem id="Female_Patient_menu" 
        name="Female Patient"
        action="action_Hospital_Female_Patient" 
        parent="Patient_menu_root" 
        sequence="0"/>

</odoo>